rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User document and private subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User's private vocabulary characters
      match /characters/{characterId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.userId == userId &&
          request.resource.data.hanzi is string &&
          request.resource.data.hanzi.size() > 0 &&
          request.resource.data.hanzi.size() <= 100;
      }

      // User's private custom word lists
      match /wordLists/{listId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.userId == userId &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 100;
      }

      // User's learning statistics
      match /stats/{statId} {
        allow read, write: if isOwner(userId);
      }

      // User's review logs
      match /reviewLogs/{logId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
