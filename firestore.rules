rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User document and private subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User's private vocabulary characters
      match /characters/{characterId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.userId == userId &&
          request.resource.data.hanzi is string &&
          request.resource.data.hanzi.size() > 0 &&
          request.resource.data.hanzi.size() <= 100;
      }

      // User's private custom word lists
      match /wordLists/{listId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.userId == userId &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 100;
      }

      // User's learning statistics
      match /stats/{statId} {
        allow read, write: if isOwner(userId);
      }

      // User's review logs
      match /reviewLogs/{logId} {
        allow read, write: if isOwner(userId);
      }

      // User's in-progress study sessions (cross-device resume)
      match /savedSessions/{sessionId} {
        allow get, delete: if isOwner(userId) && isValidId(sessionId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(sessionId) &&
          request.resource.data.userId == userId &&
          request.resource.data.id == sessionId &&
          request.resource.data.mode is string &&
          request.resource.data.mode.size() > 0 &&
          request.resource.data.mode.size() <= 50 &&
          request.resource.data.questions is list &&
          request.resource.data.questions.size() > 0 &&
          request.resource.data.questions.size() <= 5000 &&
          request.resource.data.currentIndex is number &&
          request.resource.data.currentIndex >= 0 &&
          request.resource.data.updatedAt is number;
      }

      // User's daily AI lookup usage
      match /usage/{usageId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(usageId) &&
          request.resource.data.userId == userId &&
          request.resource.data.date is string &&
          request.resource.data.date.size() <= 20 &&
          request.resource.data.enrichCount is number &&
          request.resource.data.enrichCount >= 0 &&
          request.resource.data.mnemonicCount is number &&
          request.resource.data.mnemonicCount >= 0;
      }
    }

    // Shared community dictionary & mnemonic cache
    match /sharedDictionary/{entryId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(entryId) &&
        request.resource.data.id == entryId &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.hanzi is string &&
        request.resource.data.hanzi.size() > 0 &&
        request.resource.data.hanzi.size() <= 50 &&
        request.resource.data.pinyin is string &&
        request.resource.data.pinyin.size() <= 200 &&
        request.resource.data.meaning is string &&
        request.resource.data.meaning.size() > 0 &&
        request.resource.data.meaning.size() <= 500 &&
        request.resource.data.updatedAt is number;
      allow update: if isSignedIn() && isValidId(entryId) &&
        request.resource.data.id == entryId &&
        request.resource.data.hanzi == resource.data.hanzi &&
        request.resource.data.hanzi.size() <= 50 &&
        request.resource.data.pinyin is string &&
        request.resource.data.pinyin.size() <= 200 &&
        request.resource.data.meaning is string &&
        request.resource.data.meaning.size() > 0 &&
        request.resource.data.meaning.size() <= 500 &&
        request.resource.data.updatedAt is number;
      allow delete: if false;
    }
  }
}
